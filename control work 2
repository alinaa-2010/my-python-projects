import sqlite3
import time
from datetime import datetime
from abc import ABC, abstractmethod

# DECORATORS

def log_action(func):
    def wrapper(*args, **kwargs):
        start = time.time()

        result = func(*args, **kwargs)

        end = time.time()
        print(f"[LOG] {func.__name__} выполнен в {datetime.now()}")
        print(f"[TIME] {(end - start):.4f} секунд")
        return result
    return wrapper


def admin_required(func):
    def wrapper(user, *args, **kwargs):
        if not isinstance(user, Admin):
            print("[ERROR] Доступ запрещён! Только администратор!")
            return None
        return func(user, *args, **kwargs)
    return wrapper


# UTILS

class Validator:
    @staticmethod
    def validate_email(email):
        return "@" in email and "." in email


# DATABASE

class Database:
    def __init__(self, db_name="academy.db"):
        self.conn = sqlite3.connect(db_name)
        self.cursor = self.conn.cursor()

    def execute(self, query, params=()):
        self.cursor.execute(query, params)
        self.conn.commit()

    def fetchall(self, query, params=()):
        self.cursor.execute(query, params)
        return self.cursor.fetchall()

    def fetchone(self, query, params=()):
        self.cursor.execute(query, params)
        return self.cursor.fetchone()

    def close(self):
        self.conn.close()


def create_tables():
    db = Database()

    db.execute("""
    CREATE TABLE IF NOT EXISTS students (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT NOT NULL,
        email TEXT NOT NULL,
        password TEXT NOT NULL
    )
    """)

    db.execute("""
    CREATE TABLE IF NOT EXISTS teachers (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT NOT NULL,
        email TEXT NOT NULL,
        password TEXT NOT NULL,
        subject TEXT
    )
    """)

    db.execute("""
    CREATE TABLE IF NOT EXISTS courses (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        title TEXT NOT NULL,
        description TEXT
    )
    """)

    db.execute("""
    CREATE TABLE IF NOT EXISTS enrollments (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        student_id INTEGER,
        course_id INTEGER,
        FOREIGN KEY(student_id) REFERENCES students(id),
        FOREIGN KEY(course_id) REFERENCES courses(id)
    )
    """)

    db.close()


# ABSTRACT CLASS

class User(ABC):
    @abstractmethod
    def login(self):
        pass


# MIXINS

class NotificationMixin:
    def notify(self, message):
        print(f"[NOTIFY] {message}")


class LoggerMixin:
    def log(self, message):
        print(f"[LOGGER] {message}")


# PERSON + INHERITANCE

class Person(User):
    def __init__(self, name, email, password):
        if not Validator.validate_email(email):
            raise ValueError("Неверный email!")

        self.name = name              # public
        self._email = email           # protected
        self.__password = password    # private

    def check_password(self, password):
        return self.__password == password

    def login(self):
        return f"{self.name} вошёл в систему!"

    def get_info(self):
        return f"Person: {self.name}, Email: {self._email}"

    def __str__(self):
        return self.get_info()

    def __repr__(self):
        return f"Person(name={self.name}, email={self._email})"


# STUDENT

class Student(Person):
    def __init__(self, name, email, password):
        super().__init__(name, email, password)

    def get_info(self):
        return f"Student: {self.name}, Email: {self._email}"

    def __eq__(self, other):
        return isinstance(other, Student) and self.name == other.name

    @classmethod
    def from_string(cls, string_data):
        # "Alina, alina@gmail.com, 1234"
        name, email, password = string_data.split(",")
        return cls(name.strip(), email.strip(), password.strip())

# TEACHER (Multiple Inheritance)

class Teacher(Person, NotificationMixin, LoggerMixin):
    def __init__(self, name, email, password, subject=""):
        super().__init__(name, email, password)
        self.subject = subject

    def get_info(self):
        return f"Teacher: {self.name}, Subject: {self.subject}"


# ADMIN

class Admin(Person):
    def get_info(self):
        return f"Admin: {self.name}"

# COURSE

class Course:
    def __init__(self, title, description=""):
        self.title = title
        self.description = description
        self.students = []

    def add_student(self, student):
        self.students.append(student)

    def __len__(self):
        return len(self.students)

    def __str__(self):
        return f"Course: {self.title} ({len(self.students)} students)"

    def __repr__(self):
        return f"Course(title={self.title})"


# SERVICES (CRUD)

class StudentService:

    @log_action
    def add_student(self, name, email, password):
        db = Database()
        db.execute("INSERT INTO students(name, email, password) VALUES(?, ?, ?)",
                   (name, email, password))
        db.close()
        print("Студент добавлен!")

    def get_students(self):
        db = Database()
        students = db.fetchall("SELECT id, name, email FROM students")
        db.close()
        return students

    @log_action
    def update_student(self, student_id, new_name, new_email):
        db = Database()
        db.execute("UPDATE students SET name = ?, email = ? WHERE id = ?",
                   (new_name, new_email, student_id))
        db.close()
        print("Студент обновлён!")

    @admin_required
    @log_action
    def delete_student(self, admin_user, student_id):
        db = Database()
        db.execute("DELETE FROM students WHERE id = ?", (student_id,))
        db.close()
        print("Студент удалён!")


